{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CS2人机增强助手",
  "mainBinaryName": "CS2BotImproverAssistant",
  "version": "0.5.6",
  "identifier": "com.aipc.cs2botimprover",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS2人机增强助手",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false
      },
      {
        "label": "scoreboard",
        "title": "本局战报",
        "url": "scoreboard.html",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "resources": [
      "resources/CS2BotImprover.zip",
      "resources/demo-maps",
      "../LICENSE",
      "../NOTICE.md"
    ],
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFN0ZEMTNFRDEzQzA4OTgKUldTWUNEelJQdEYvWG16NFFnd2trVnVEM3hySVlNTHhXbFBUOTY5ZHR6RTl6Tnc3T216YnFIVloK",
      "endpoints": [
        "https://cs2as.600318.xyz/api/software-updater/cs2-bot-improver/prod/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
