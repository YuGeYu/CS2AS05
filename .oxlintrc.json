{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    "backups/**",
    "src-tauri/resources/**",
    "workspace/**",
    "dist/**",
    "dist-release/**",
    "output/**",
    "video-output/**",
    "video-cs2-*/**"
  ],
  "categories": {
    "correctness": "error"
  }
}
