{
  "name": "cs2-bot-improver-assistant",
  "version": "0.5.14",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/YuGeYu/CS2AS05#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGeYu/CS2AS05.git"
  },
  "bugs": {
    "url": "https://github.com/YuGeYu/CS2AS05/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:desktop": "tauri dev",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "test": "vitest run",
    "build:web": "vite build",
    "build:desktop": "tauri build --no-bundle",
    "bundle:desktop": "tauri build",
    "workspace:check": "node ./scripts/workspace-check.mjs",
    "verify": "run-s workspace:check typecheck lint test build:web",
    "release:manifest": "node ./scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "three": "^0.185.1",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
